MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Anchor
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_EXPIRES_IN=1h
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
PORT=5000
# AI — all calls go through backend/llm (see docs/step0.md). Defaults below
# reproduce the classic setup: GitHub Models primary, Gemini fallback, then a
# rule-based answer if both fail. Leave every key unset to run rule-based only.
LLM_API_KEY=github_pat_your-token
LLM_BASE_URL=https://models.github.ai/inference
LLM_MODEL=openai/gpt-4.1-mini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# Optional overrides:
# LLM_PROVIDER=openai                 # primary provider id (openai | gemini)
# LLM_FALLBACKS=gemini:gemini-2.5-flash  # comma list of provider:model, or "none"
# LLM_TIMEOUT_MS=20000
# LLM_MAX_RETRIES=2
# LLM_MAX_RETRY_WAIT_MS=8000
# LLM_QUEUE_TIMEOUT_MS=5000
# LLM_RPM_OPENAI=15
# LLM_TPM_OPENAI=0                    # 0 = unlimited
# LLM_RPM_GEMINI=10
# LLM_TPM_GEMINI=250000
# Migrations run on boot (additive + idempotent). Set false to run manually
# with `npm run migrate`.
# RUN_MIGRATIONS_ON_BOOT=true
# Email verification (codes via Brevo). Leave REQUIRE_EMAIL_VERIFICATION unset
# locally — register then behaves classically (no code, instant tokens).
REQUIRE_EMAIL_VERIFICATION=true
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER=anchorr26@gmail.com
GOOGLE_WEB_CLIENT_ID=your-google-web-oauth-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-google-ios-oauth-client-id.apps.googleusercontent.com
APPLE_BUNDLE_ID=dev.gradproject.anchor
