MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Anchor
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_EXPIRES_IN=1h
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
PORT=5000
# AI — all calls go through backend/llm (see docs/step0.md). Default chain,
# picked per task tier (providers without a key are skipped):
#   insights (strong):          Gemini 3.8 Flash → 3.5 Flash-Lite → GitHub gpt-4.1-mini → rule-based
#   tips/coach/planner (fast):  Gemini 3.5 Flash-Lite → GitHub gpt-4.1-mini → rule-based
# Leave every key unset to run rule-based only.
GEMINI_API_KEY=your-gemini-api-key        # https://aistudio.google.com → API keys
GEMINI_MODEL=gemini-3.8-flash             # strong tier
GEMINI_MODEL_FAST=gemini-3.5-flash-lite   # fast tier (and strong-tier fallback)
# GEMINI_THINKING_LEVEL=LOW               # Gemini 3+: MINIMAL | LOW | MEDIUM | HIGH ('' = omit)
LLM_API_KEY=github_pat_your-token         # GitHub fine-grained PAT, Models: read-only
LLM_BASE_URL=https://models.github.ai/inference
LLM_MODEL=openai/gpt-4.1-mini
# LLM calls per user per UTC day (0 = unlimited); over it → rule-based answers.
AI_DAILY_LIMIT=50
# Optional overrides — setting either one replaces the tiered default with
# one explicit chain used for every task:
# LLM_PROVIDER=gemini                    # primary provider id (openai | gemini)
# LLM_FALLBACKS=openai:openai/gpt-4.1-mini  # comma list of provider:model, or "none"
# LLM_TIMEOUT_MS=20000
# LLM_MAX_RETRIES=2
# LLM_MAX_RETRY_WAIT_MS=8000
# LLM_QUEUE_TIMEOUT_MS=5000
# LLM_RPM_OPENAI=15
# LLM_TPM_OPENAI=0                    # 0 = unlimited
# LLM_RPM_GEMINI=10
# LLM_TPM_GEMINI=250000
# Migrations run on boot (additive + idempotent). Set false to run manually
# with `npm run migrate`.
# RUN_MIGRATIONS_ON_BOOT=true
# Email verification (codes via Brevo). Leave REQUIRE_EMAIL_VERIFICATION unset
# locally — register then behaves classically (no code, instant tokens).
REQUIRE_EMAIL_VERIFICATION=true
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER=anchorr26@gmail.com
GOOGLE_WEB_CLIENT_ID=your-google-web-oauth-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-google-ios-oauth-client-id.apps.googleusercontent.com
APPLE_BUNDLE_ID=dev.gradproject.anchor
